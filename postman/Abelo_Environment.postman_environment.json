{
  "id": "abelo-api-environment",
  "name": "Abelo API (Production)",
  "values": [
    {
      "key": "baseUrl",
      "value": "https://api.abelo.ai/v1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "authMethod",
      "value": "bearer",
      "type": "default",
      "description": "Authentication method: 'bearer' (standard) or 'hmac' (enterprise request-signing)",
      "enabled": true
    },
    {
      "key": "apiKeyId",
      "value": "YOUR_API_KEY_ID",
      "type": "secret",
      "description": "Public API Key ID (e.g. key_live_abc123)",
      "enabled": true
    },
    {
      "key": "apiKeySecret",
      "value": "YOUR_API_KEY_SECRET",
      "type": "secret",
      "description": "API Key Secret for Bearer auth (e.g. sec_live_xyz789)",
      "enabled": true
    },
    {
      "key": "hmacSecret",
      "value": "YOUR_HMAC_SECRET",
      "type": "secret",
      "description": "HMAC Secret for request signing (only needed if authMethod is 'hmac')",
      "enabled": true
    },
    {
      "key": "viberCampaignId",
      "value": "YOUR_VIBER_CAMPAIGN_ID",
      "type": "default",
      "description": "Viber API Campaign ID created in the Abelo Console",
      "enabled": true
    },
    {
      "key": "smsCampaignId",
      "value": "YOUR_SMS_CAMPAIGN_ID",
      "type": "default",
      "description": "SMS API Campaign ID created in the Abelo Console",
      "enabled": true
    },
    {
      "key": "testPhoneNumber",
      "value": "+306912345678",
      "type": "default",
      "description": "E.164 formatted recipient phone number",
      "enabled": true
    },
    {
      "key": "testProfileId",
      "value": "prf_live_sample123",
      "type": "default",
      "description": "Sample Profile public ID for path variables",
      "enabled": true
    },
    {
      "key": "testWebhookId",
      "value": "whk_sample123",
      "type": "default",
      "description": "Sample Webhook ID for path variables",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}