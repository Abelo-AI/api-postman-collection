            "description": "Retrieves configuration for a specific webhook."
          }
        },
        {
          "name": "Update Webhook",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Delivery Receipts\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/:webhook_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                ":webhook_id"
              ],
              "variable": [
                {
                  "key": "webhook_id",
                  "value": "{{testWebhookId}}",
                  "description": "Webhook ID"
                }
              ]
            },
            "description": "Updates an existing webhook configuration."
          }
        },
        {
          "name": "Delete Webhook",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhooks/:webhook_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                ":webhook_id"
              ],
              "variable": [
                {
                  "key": "webhook_id",
                  "value": "{{testWebhookId}}",
                  "description": "Webhook ID"
                }
              ]
            },
            "description": "Permanently deletes a registered webhook configuration."
          }
        },
        {
          "name": "Rotate Webhook Secret",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhooks/:webhook_id/rotate-secret",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                ":webhook_id",
                "rotate-secret"
              ],
              "variable": [
                {
                  "key": "webhook_id",
                  "value": "{{testWebhookId}}",
                  "description": "Webhook ID"
                }
              ]
            },
            "description": "Rotates the HMAC signing secret used for webhook event delivery."
          }
        },
