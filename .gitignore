# ==============================================================================
# Abelo REST API Postman Collection & Developer Quickstarts - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Credentials & Environment Configurations
# ------------------------------------------------------------------------------
# Ignore all local environment files containing real API keys or sensitive data
.env
.env.*
!.env.example
!.env.template

# Private keys, certificates, and credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# ------------------------------------------------------------------------------
# Postman, Newman & API Testing Artifacts
# ------------------------------------------------------------------------------
# Do not commit environment or data files containing live secrets/PII
postman/*.local.json
postman/*.secret.json
postman/*.private.json
*.local.json
*.postman_dump.json
*.postman_test_run.json

# Newman CLI test run outputs and reports
newman/
reports/
*.newman-report.*

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ, PyCharm, WebStorm, etc.)
.idea/

# Visual Studio Code
.vscode/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Editor swap and backup files
*.swp
*.swo
*.bak
*.orig

# ------------------------------------------------------------------------------
# Python (Examples & Utilities)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
venv/
ENV/
env/

# Python packaging & test caches
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js (Examples & Tooling)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# General Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
