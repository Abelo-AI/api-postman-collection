      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Create a Webhook",
        "description": "Creates a new webhook subscription. The `signing_secret` is returned **exactly once** — store it securely. It cannot be re-retrieved; use the rotate-secret endpoint to generate a new one.\n### Global Webhook Rules\n* **Limit:** An organization can have a maximum of **5 active webhooks** at any time.\n* **Topic Overlap:** Active webhooks cannot subscribe to overlapping topics. If a topic is \nconfigured in one active webhook, it cannot be configured in another active webhook.\n* **Inactive Webhooks:** Inactive webhooks do not count towards the \nlimit of 5 webhooks and are exempt from topic overlap validation until they are activated.",
        "operationId": "create_webhook_webhooks_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookCreateResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid API Key"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "400": {
            "description": "Bad Request - Too many active webhooks or topics overlap"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
